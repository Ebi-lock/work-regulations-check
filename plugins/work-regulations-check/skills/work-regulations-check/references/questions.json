        },
        {
          "id": "summer",
          "text": "夏季休暇はありますか？",
          "options": [
            "あり",
            "なし"
          ],
          "default": "なし",
          "affects": "特別休暇の条"
        },
        {
          "id": "yearend",
          "text": "年末年始休暇はありますか？",
          "options": [
            "あり",
            "なし"
          ],
          "default": "あり",
          "affects": "休日または特別休暇の条"
        },
        {
          "id": "congrats",
          "text": "慶弔休暇はありますか？",
          "options": [
            "あり",
            "なし"
          ],
          "default": "あり",
          "affects": "特別休暇の条"
        },
        {
          "id": "congrats_paid",
          "text": "慶弔休暇は有給ですか、無給ですか？",
          "options": [
            "有給",
            "無給"
          ],
          "default": "有給",
          "depends_on": {
            "holiday.congrats": "あり"
          },
          "affects": "特別休暇の条"
        },
        {
          "id": "yukyu_base",
          "text": "年次有給休暇の付与基準日は？",
          "options": [
            "入社日から6か月後（個別）",
            "全社一斉付与"
          ],
          "default": "入社日から6か月後（個別）",
          "affects": "年休の条"
        },
        {
          "id": "yukyu_half",
          "text": "半日単位の年休を認めますか？",
          "options": [
            "あり",
            "なし"
          ],
          "default": "あり",
          "affects": "年休の条"
        },
        {
          "id": "yukyu_hour",
          "text": "時間単位の年休を認めますか？",
          "options": [
            "あり",
            "なし"
          ],
          "default": "なし",
