{
  "sections": [
    {
      "id": "base",
      "title": "1. 会社の基本情報",
      "note": "ここが決まらないと条文の主語が書けません。",
      "questions": [
        {
          "id": "company",
          "text": "会社の正式名称は？（株式会社の位置も含めて）",
          "affects": "第1条、附則"
        },
        {
          "id": "industry",
          "text": "事業内容・業種は？",
          "why": "特例事業場に当たるかの判定に使います",
          "affects": "第2条、労働時間"
        },
        {
          "id": "sites",
          "text": "事業場はいくつありますか？（本社のみ／支店・営業所・工場あり）",
          "why": "届出は事業場ごとに行います",
          "options": [
            "本社のみ",
            "複数ある"
          ],
          "default": "本社のみ",
          "affects": "適用範囲、届出"
        },
        {
          "id": "term",
          "text": "従業員の呼び方は？",
          "why": "規程全体で統一します",
          "options": [
            "従業員",
            "社員",
            "職員"
          ],
          "default": "労働者",
          "affects": "規程全体"
        }
      ]
    },
    {
      "id": "workforce",
      "title": "2. 従業員の構成",
      "note": "雇用形態の内訳を飛ばすと、その層に適用される規則が無いという穴があきます。",
      "questions": [
        {
          "id": "total",
          "text": "常時使用する労働者は何人ですか？（パート・アルバイトを含む）",
          "why": "10人以上なら作成・届出義務があります（労基法89条）",
          "caution": "正社員だけで数えないこと。パート・アルバイトも含みます",
          "affects": "届出義務"
        },
        {
          "id": "regular",
          "text": "正社員は何人ですか？",
          "affects": "適用範囲"
        },
        {
          "id": "parttime",
          "text": "パート・アルバイトは何人ですか？（0人なら0）",
          "caution": "いる場合、その層に適用される規則が別に必要です",
          "affects": "第2条、パート就業規則"
        },
        {
          "id": "contract",
          "text": "契約社員（有期雇用）は何人ですか？（0人なら0）",
          "affects": "第2条、無期転換"
        },
        {
          "id": "rehire",
          "text": "定年後再雇用の方はいますか？（0人なら0）",
          "affects": "定年・再雇用の条"
        },
        {
          "id": "parttime_rule",
          "text": "パート・有期向けの就業規則は作りますか？",
          "why": "本則を正社員限定にするなら、その層の規則が別に要ります",
          "options": [
            "本則とは別に作る",
            "本則を適用する（一部を別に定める）",
            "今回は作らない"
          ],
          "affects": "第2条"
        }
      ]
    },
    {
      "id": "worktime",
      "title": "3. 労働時間",
      "note": "運用している制度が規程に無いと、その制度自体が無効になります。",
      "questions": [
        {
          "id": "start",
          "text": "始業時刻は？",
          "options": [
            "午前9時",
            "午前8時30分",
            "部署によって違う"
          ],
          "default": "午前9時",
          "affects": "労働時間の条"
        },
        {
          "id": "end",
          "text": "終業時刻は？",
          "options": [
            "午後6時",
            "午後5時30分",
            "部署によって違う"
          ],
          "default": "午後6時",
          "affects": "労働時間の条"
        },
        {
          "id": "break",
          "text": "休憩時間は？",
          "why": "6時間超で45分、8時間超で60分以上が必要です（労基法34条）",
          "options": [
            "正午から60分",
            "正午から45分",
            "交替で60分"
          ],
          "default": "正午から60分",
          "affects": "休憩の条"
        },
        {
          "id": "break_shift",
          "text": "休憩は全員一斉に取りますか？",
          "why": "一斉付与が原則です。交替で取らせるには労使協定が要ります（労基法34条2項）",
          "options": [
            "一斉に取る",
            "交替で取る"
          ],
          "default": "一斉に取る",
          "affects": "休憩の条、労使協定"
        },
        {
          "id": "overtime",
          "text": "時間外労働（残業）はありますか？",
          "why": "させるなら36協定の締結・届出が前提になります",
          "options": [
            "あり",
            "なし"
          ],
          "default": "あり",
          "affects": "時間外労働の条、36協定"
        },
        {
          "id": "night",
          "text": "深夜労働（22時〜5時）はありますか？",
          "options": [
            "あり",
            "なし"
          ],
          "default": "なし",
          "affects": "割増賃金の条"
        },
        {
          "id": "shift",
          "text": "シフト勤務・交替制はありますか？",
          "why": "あるなら交替順序と就業時転換の方法が必要記載事項になります",
          "options": [
            "あり",
            "なし"
          ],
          "default": "なし",
          "affects": "労働時間の条"
        },
        {
          "id": "variable",
          "text": "変形労働時間制を使っていますか？",
          "why": "運用しているのに規程に無いと、制度が無効になります",
          "options": [
            "使っていない",
            "1か月単位",
            "1年単位",
            "1週間単位"
          ],
          "default": "使っていない",
          "affects": "変形労働時間制の条"
        },
        {
          "id": "flex",
          "text": "フレックスタイム制を使っていますか？",
          "options": [
            "あり",
            "なし"
          ],
          "default": "なし",
          "affects": "フレックスの条、労使協定"
        },
        {
          "id": "flex_core",
          "text": "コアタイムは設けますか？（設けるなら時間帯）",
          "depends_on": {
            "worktime.flex": "あり"
          },
          "affects": "フレックスの条"
        },
        {
          "id": "discretion",
          "text": "裁量労働制を使っていますか？",
          "options": [
            "使っていない",
            "専門業務型",
            "企画業務型"
          ],
          "default": "使っていない",
          "caution": "専門業務型は2024年4月から本人同意が必要です",
          "affects": "裁量労働の条"
        },
        {
          "id": "telework",
          "text": "テレワークはありますか？",
          "options": [
            "あり",
            "なし"
          ],
          "default": "なし",
          "affects": "テレワークの条"
        },
        {
          "id": "telework_cost",
          "text": "テレワークの費用（通信費・光熱費）は誰が負担しますか？",
          "depends_on": {
            "worktime.telework": "あり"
          },
          "affects": "テレワークの条"
        }
      ]
    },
    {
      "id": "holiday",
